int Led=12;//Conectar led al pin 12//
void setup() {
  
pinMode(12,OUTPUT); //Configurar los pines//
}

void loop(){
  digitalWrite(12,HIGH); //Se enciende el Led//
  delay(100);
  
  digitalWrite(12,LOW); //Se apaga el Led//
  delay(100);
}
