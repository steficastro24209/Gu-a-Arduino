int led=11; /Conectar al pin 11/
int led2=10;/ Conectar al pin 10/
int led3=9; / Conectar al pin 9/
int dt=100;/Tiempo de espera/
void setup() {
  /Configurar los pines/
  pinMode(led,OUTPUT);
  pinMode(led2,OUTPUT);
  pinMode(led3,OUTPUT);
}

void loop() {
  /Envio de señal o de corriente para encender/
    digitalWrite(led,HIGH); 
    digitalWrite(led2,HIGH);
    digitalWrite(led3,HIGH);
  ;
}
