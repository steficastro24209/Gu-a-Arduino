//Punto 23
int L1 = 3;
int L2 = 4;
int trig = 5;
int echo = 6;
int TT;
void setup() {
  //Programar Leds
  pinMode(L1, OUTPUT);
  pinMode(L1, OUTPUT);
  pinMode(trig, OUTPUT);
  pinMode(echo, INPUT);
  Serial.begin(9600);
}

void loop() {
  digitalWrite(trig, HIGH);//Encendido
  delayMicroseconds(10);
  TT = pulseIn(echo, HIGH);
  delay(25);
  digitalWrite(trig, LOW);//Apagado
  Serial.println(TT);
  if (TT >= 10000) {
    digitalWrite(L1, HIGH);
    delay(1000);
    digitalWrite(L2, HIGH);
    delay(1000);
  }

  if (TT <= 5000) {
    digitalWrite(L1, HIGH);
    delay(1000);
    digitalWrite(L2, LOW);/Apagado
    delay(1000);
  }
  if (TT >= 5000) {
    digitalWrite(L1, LOW);
    delay(1000);
    digitalWrite(L2, HIGH);
    delay(1000);
  }
  else {
    digitalWrite(L1, LOW);/Apagado
    delay(1000);
    digitalWrite(L2, LOW);
    delay(1000);
  }
}
