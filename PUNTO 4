//Punto 4
//https://www.youtube.com/watch?v=eYgqP9JDjO0
int L1=6;//Led 1 al pin 6
int L2=5;//Led 2 al pin 5
int L3=4;//Led 3 al pin 4
int L4=3;//Led 4 al pin 3
void setup() {
  //Configurar los pines
 pinMode(L1,OUTPUT);//led 1
 pinMode(L2,OUTPUT);//led 2
 pinMode(L3,OUTPUT);//led 3
 pinMode(L4,OUTPUT);//led 4
 
}

void loop() {

  digitalWrite(L1,LOW),digitalWrite(L2,LOW),digitalWrite(L3,LOW),digitalWrite(L4,LOW);//Decimal (0)0000
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L2,LOW),digitalWrite(L3,LOW),digitalWrite(L4,HIGH);//Decimal(1)0001
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L2,LOW),digitalWrite(L4,LOW),digitalWrite(L3,HIGH);//Decimal (2)0010
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L2,LOW),digitalWrite(L3,LOW),digitalWrite(L4,HIGH);//Decimal (3)0011
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L3,LOW),digitalWrite(L4,LOW),digitalWrite(L2,HIGH);//Decimal (4)0100
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L3,LOW),digitalWrite(L2,HIGH),digitalWrite(L4,HIGH);//Decimal (5)0101
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L4,LOW),digitalWrite(L2,HIGH),digitalWrite(L3,HIGH);//Decimal (6)0110
  delay(1000);
  digitalWrite(L1,LOW),digitalWrite(L2,HIGH),digitalWrite(L3,HIGH),digitalWrite(L4,HIGH);//Decimal (7)0111
  delay(1000);
  digitalWrite(L2,LOW),digitalWrite(L3,LOW),digitalWrite(L1,LOW),digitalWrite(L1,HIGH);//Decimal (8)1000
  delay(1000);
  digitalWrite(L2,LOW),digitalWrite(L3,LOW),digitalWrite(L1,HIGH),digitalWrite(L4,HIGH);//Decimal (9)1001
  delay(1000);
  digitalWrite(L2,LOW),digitalWrite(L4,LOW),digitalWrite(L1,HIGH),digitalWrite(L3,HIGH);//Decimal (10)1010
  delay(1000);
  digitalWrite(L2,LOW),digitalWrite(L1,HIGH),digitalWrite(L3,HIGH),digitalWrite(L4,HIGH);//Decimal(11)1011
  delay(1000);
  digitalWrite(L3,LOW),digitalWrite(L4,LOW),digitalWrite(L1,HIGH),digitalWrite(L2,HIGH);//Decimal(12)1100
  delay(1000);
  digitalWrite(L3,LOW),digitalWrite(L1,HIGH),digitalWrite(L2,HIGH),digitalWrite(L4,HIGH);//Decimal(13)1101  
  delay(1000);
  digitalWrite(L4,LOW),digitalWrite(L1,HIGH),digitalWrite(L2,HIGH),digitalWrite(L3,HIGH);//Decimal (14)1110
  delay(1000);
  digitalWrite(L1,HIGH),digitalWrite(L2,HIGH),digitalWrite(L3,HIGH),digitalWrite(L4,HIGH);//Decimal(15)1111
  delay(1000);

}
